/* =========================================================================
 * Tema del metrónomo (imusic-school): fondo #202020, texto #F9F9F9,
 * acento #FA5E46, gris de controles #889299.
 * ========================================================================= */

MainWindow {
    background-color: #202020;
}

QLabel, QCheckBox {
    color: #F9F9F9;
    background: transparent;
}

QLabel#bpm {
    color: #FA5E46;
    font-size: 112px;
    font-weight: 800;
}

QLabel#tempo {
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    min-height: 18px;
}

QLabel#counter {
    font-size: 14px;
    font-weight: bold;
}

QCheckBox {
    font-size: 11px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #889299;
    border-radius: 2px;
    background: transparent;
}

QCheckBox::indicator:checked {
    border-color: #FA5E46;
    background: #FA5E46;
}

QSlider::groove:horizontal {
    height: 3px;
    background: #889299;
}

QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -9px 0;
    border-radius: 10px;
    background: #FA5E46;
}

QPushButton#tap {
    background: #FFFFFF;
    color: #FA5E46;
    border: 1px solid #D9E4E6;
    border-radius: 5px;
    font-size: 20px;
    font-weight: bold;
}

QPushButton#tap:pressed {
    background: #F0F0F0;
}

QToolButton#noteButton {
    background: #889299;
    border: none;
    border-radius: 4px;
}

QToolButton#noteButton:hover,
QToolButton#noteButton[state="set"] {
    background: #FA5E46;
}

QToolButton#noteButton[state="active"] {
    background: #FFFFFF;
}

QFrame#separator {
    color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.2);
    max-height: 1px;
}
